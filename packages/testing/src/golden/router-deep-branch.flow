flow "router-deep-branch" {
  node seed: prompt @(0, 0) {
    template = "prose"
    providerId = "mock"
    modelId = "m"
  }

  node router: router @(1, 0) {
    routes = ["code", "prose"]
    cases = [{value: "code", route: "code"}, {value: "prose", route: "prose"}]
  }

  node codeAnswer: prompt @(2, 0) {
    template = "CODE: {{q}}"
    providerId = "mock"
    modelId = "m"
  }

  node codeRefine: prompt @(3, 0) {
    template = "REFINE: {{c}}"
    providerId = "mock"
    modelId = "m"
  }

  node codeFinal: prompt @(4, 0) {
    template = "FINAL: {{c}}"
    providerId = "mock"
    modelId = "m"
  }

  node proseAnswer: prompt @(2, 1) {
    template = "PROSE: {{q}}"
    providerId = "mock"
    modelId = "m"
  }

  node merge: merge @(5, 0) {
  }

  node final: prompt @(6, 0) {
    template = "DONE: {{m}}"
    providerId = "mock"
    modelId = "m"
  }

  seed.output -> router.input
  router.code -> codeAnswer.q
  router.prose -> proseAnswer.q
  codeAnswer.output -> codeRefine.c
  codeRefine.output -> codeFinal.c
  codeFinal.output -> merge.in1
  proseAnswer.output -> merge.in2
  merge.output -> final.m
}
